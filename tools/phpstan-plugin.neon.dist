# @copyright Copyright (c) 2026, Peter Gribanov
# @license   https://www.gnu.org/licenses/gpl-3.0.html GPL-3.0-or-later
#
# Конфиг анализа ОДНОГО плагина, в отличие от phpstan.neon.dist, который покрывает
# тулинг самого репозитория. Вручную его не запускают: анализируемые файлы передаёт
# аргументами tools/analyse-plugin.php (список публикуемых .php плагина —
# PublishedContentRules), он же делает рабочим каталогом каталог плагина, чтобы
# PHPStan увидел зависимости плагина. Поэтому здесь нет ни paths, ни excludePaths.
#
# Путь включения ведёт в vendor/ РЕПОЗИТОРИЯ, а не в vendor/ плагина, и это несущее
# решение, а не сокращение записи:
#
#   * Гейт обязан быть доверенным кодом. composer.json плагина приезжает тем же PR,
#     что и код плагина, и может объявить свой repositories с форком
#     anime-db/plugin-contracts — тогда плагин проходил бы гейт по правилам, которые
#     сам же и привёз.
#   * Сверять сигнатуры надо с той версией контракта, которая будет у плагина в
#     рантайме, а её даёт хост: vendor/ в дистрибутив плагина не попадает вовсе
#     (см. PluginZipBuilder). Версия, зафиксированная в корневом composer.json, —
#     представитель хостовой, а vendor/ внутри плагина существует только ради его
#     локального тулинга.
#
# Порядок автолоадеров закрепляет то же самое: корневой регистрируется первым (его
# подключает vendor/bin/phpstan), а автолоадер плагина PHPStan подхватывает по
# рабочему каталогу как проект — поэтому классы AnimeDb\PluginContracts\* резолвятся
# из vendor/ репозитория даже когда в vendor/ плагина лежит своя копия пакета.
# Проверено подменой обеих копий; --autoload-file это свойство ЛОМАЕТ, см. комментарий
# в tools/analyse-plugin.php.

includes:
    - ../vendor/anime-db/plugin-contracts/extension.neon

parameters:
    level: 8
