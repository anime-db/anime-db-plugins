{# A standalone page, unlike settings.html.twig's fragment: the OAuth callback is opened by
 # the system browser (Shikimori redirects here directly), not embedded in the app's own UI. #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ 'oauth_result.page_title'|trans({}, 'animedb-shikimori') }}</title>
</head>
<body>
    {% if success %}
        <h1>{{ 'oauth_result.heading.success'|trans({}, 'animedb-shikimori') }}</h1>
    {% else %}
        <h1>{{ 'oauth_result.heading.failure'|trans({}, 'animedb-shikimori') }}</h1>
    {% endif %}
    <p>{{ message|trans({}, 'animedb-shikimori') }}</p>
    {% if warning %}
        <p class="warning">{{ warning|trans({}, 'animedb-shikimori') }}</p>
    {% endif %}
</body>
</html>
