{#
 # Shared by related.html.twig/similar.html.twig: wraps the host's `plugin/_widget_list.html.twig`
 # helper into a CSS-only horizontal-scroll "carousel" (no JS, no separate asset file — the plugin
 # ships no assets, so the rule lives inline here).
 #
 # Expects `items`, same shape as `plugin/_widget_list.html.twig` expects.
 #}
<div class="animedb-shikimori-carousel">
    <style>
        .animedb-shikimori-carousel .plugin-widget__list {
            display: flex;
            flex-wrap: nowrap;
            overflow-x: auto;
            gap: 0.75rem;
            padding-bottom: 0.25rem;
        }
        .animedb-shikimori-carousel .plugin-widget__list > li {
            flex: 0 0 auto;
        }
    </style>
    {% include 'plugin/_widget_list.html.twig' with {'items': items} only %}
</div>
