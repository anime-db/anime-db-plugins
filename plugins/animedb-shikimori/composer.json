{
    "name": "anime-db/animedb-shikimori",
    "description": "Официальный плагин-источник Shikimori для AnimeDB (поиск и заполнение карточек).",
    "type": "anime-db-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.1",
        "anime-db/plugin-contracts": "^0.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/http-kernel": "^6.4",
        "symfony/http-foundation": "^6.4",
        "symfony/security-csrf": "^6.4",
        "twig/twig": "^3.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/anime-db/anime-db-plugin-contracts"
        }
    ],
    "autoload": {
        "psr-4": {
            "AnimeDb\\Plugins\\AnimedbShikimori\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AnimeDb\\Plugins\\AnimedbShikimori\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
