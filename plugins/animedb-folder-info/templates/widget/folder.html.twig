{# Raw fragment rendered by FolderWidget; the controller's HTMX response replaces #animedb-folder-info-<id>. #}
<div id="animedb-folder-info-{{ animeId }}" class="animedb-folder-info">
    {% if error %}
        <p class="error">{{ error|trans({}, 'animedb-folder-info') }}</p>
    {% endif %}
    <p class="status status-{{ status }}">
        {{ ('widget.folder.status.' ~ status)|trans({}, 'animedb-folder-info') }}
        {% if writtenAt is not null %}
            ({{ 'widget.folder.written_at'|trans({}, 'animedb-folder-info') }} {{ writtenAt|date('Y-m-d H:i') }})
        {% endif %}
    </p>
    {% if canWrite %}
        <form hx-post="{{ path('animedb_folder_info_write', {id: animeId}) }}" hx-target="#animedb-folder-info-{{ animeId }}" hx-swap="outerHTML">
            <input type="hidden" name="_token" value="{{ csrf_token('animedb_folder_info_write') }}">
            {% if overwrite %}
                <input type="hidden" name="overwrite" value="1">
            {% endif %}
            <button type="submit">{{ (overwrite ? 'widget.folder.button.overwrite' : 'widget.folder.button.write')|trans({}, 'animedb-folder-info') }}</button>
        </form>
    {% endif %}
</div>
