{
    "name": "anime-db/animedb-myanimelist",
    "description": "Официальный плагин-источник MyAnimeList для AnimeDB (поиск и распознавание ссылок).",
    "type": "anime-db-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.5",
        "anime-db/plugin-contracts": "^0.25"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/http-kernel": "8.1.*",
        "symfony/http-foundation": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "twig/twig": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "AnimeDb\\Plugins\\AnimedbMyanimelist\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AnimeDb\\Plugins\\AnimedbMyanimelist\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
