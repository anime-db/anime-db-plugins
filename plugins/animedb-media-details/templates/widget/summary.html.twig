{# Raw fragment, rendered by SummaryWidget::render(). One record-level summary — never a
 # per-file list, see the SummaryWidget class docblock. #}
{% if state == 'pending' %}
    <p>{{ 'widget.summary.pending'|trans({}, 'animedb-media-details') }}</p>
{% elseif state == 'unavailable' %}
    <p>{{ 'widget.summary.unavailable'|trans({}, 'animedb-media-details') }}</p>
{% elseif state == 'parse_failed' %}
    <p>{{ 'widget.summary.parse_failed'|trans({}, 'animedb-media-details') }}</p>
{% elseif state == 'no_files' %}
    <p>{{ 'widget.summary.no_files'|trans({}, 'animedb-media-details') }}</p>
{% else %}
    <div class="animedb-media-details-summary">
        <p><strong>{{ 'widget.summary.files_count'|trans({'%count%': files_total}, 'animedb-media-details') }}</strong></p>
        {% if unparsed_count > 0 %}
            <p>{{ 'widget.summary.files_unparsed'|trans({'%count%': unparsed_count}, 'animedb-media-details') }}</p>
        {% endif %}
        <ul>
            <li>
                <span>{{ 'widget.summary.size_label'|trans({}, 'animedb-media-details') }}:</span> {{ size_value }} {{ size_unit_key|trans({}, 'animedb-media-details') }}
                {% if size_partial %}<em>({{ 'widget.summary.not_all_files'|trans({}, 'animedb-media-details') }})</em>{% endif %}
            </li>
            {% if duration_formatted is not null %}
                <li>
                    <span>{{ 'widget.summary.duration_label'|trans({}, 'animedb-media-details') }}:</span> {{ duration_formatted }}
                    {% if duration_partial %}<em>({{ 'widget.summary.not_all_files'|trans({}, 'animedb-media-details') }})</em>{% endif %}
                </li>
            {% endif %}
            {% if video_codec is not null %}
                <li>
                    <span>{{ 'widget.summary.video_codec_label'|trans({}, 'animedb-media-details') }}:</span>
                    {{ video_codec.shown|join(', ') }}{% if video_codec.moreCount > 0 %} {{ 'widget.summary.more_values'|trans({'%count%': video_codec.moreCount}, 'animedb-media-details') }}{% endif %}
                </li>
            {% endif %}
            {% if video_resolution is not null %}
                <li>
                    <span>{{ 'widget.summary.video_resolution_label'|trans({}, 'animedb-media-details') }}:</span>
                    {{ video_resolution.shown|join(', ') }}{% if video_resolution.moreCount > 0 %} {{ 'widget.summary.more_values'|trans({'%count%': video_resolution.moreCount}, 'animedb-media-details') }}{% endif %}
                </li>
            {% endif %}
            {% if video_frame_rate is not null %}
                <li>
                    <span>{{ 'widget.summary.video_frame_rate_label'|trans({}, 'animedb-media-details') }}:</span>
                    {{ video_frame_rate.shown|join(', ') }}{% if video_frame_rate.moreCount > 0 %} {{ 'widget.summary.more_values'|trans({'%count%': video_frame_rate.moreCount}, 'animedb-media-details') }}{% endif %}
                </li>
            {% endif %}
            {% if audio_tracks is not null %}
                <li>
                    <span>{{ 'widget.summary.audio_tracks_label'|trans({}, 'animedb-media-details') }}:</span>
                    {{ audio_tracks.shown|join(', ') }}{% if audio_tracks.moreCount > 0 %} {{ 'widget.summary.more_values'|trans({'%count%': audio_tracks.moreCount}, 'animedb-media-details') }}{% endif %}
                    {% if audio_tracks.partial %}<em>({{ 'widget.summary.not_all_files'|trans({}, 'animedb-media-details') }})</em>{% endif %}
                </li>
            {% endif %}
            {% if audio_languages is not null %}
                <li>
                    <span>{{ 'widget.summary.audio_languages_label'|trans({}, 'animedb-media-details') }}:</span>
                    {% if audio_languages.unknown %}
                        {{ 'widget.summary.language_unknown'|trans({}, 'animedb-media-details') }}
                    {% else %}
                        {{ audio_languages.shown|join(', ') }}{% if audio_languages.moreCount > 0 %} {{ 'widget.summary.more_values'|trans({'%count%': audio_languages.moreCount}, 'animedb-media-details') }}{% endif %}
                    {% endif %}
                    {% if audio_languages.partial %}<em>({{ 'widget.summary.not_all_files'|trans({}, 'animedb-media-details') }})</em>{% endif %}
                </li>
            {% endif %}
            {% if subtitle_languages is not null %}
                <li>
                    <span>{{ 'widget.summary.subtitle_languages_label'|trans({}, 'animedb-media-details') }}:</span>
                    {% if subtitle_languages.unknown %}
                        {{ 'widget.summary.language_unknown'|trans({}, 'animedb-media-details') }}
                    {% else %}
                        {{ subtitle_languages.shown|join(', ') }}{% if subtitle_languages.moreCount > 0 %} {{ 'widget.summary.more_values'|trans({'%count%': subtitle_languages.moreCount}, 'animedb-media-details') }}{% endif %}
                    {% endif %}
                    {% if subtitle_languages.partial %}<em>({{ 'widget.summary.not_all_files'|trans({}, 'animedb-media-details') }})</em>{% endif %}
                </li>
            {% endif %}
        </ul>
    </div>
{% endif %}
