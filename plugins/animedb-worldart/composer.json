{
    "name": "anime-db/animedb-worldart",
    "description": "Официальный плагин-источник World-Art для AnimeDB (поиск по названию и распознавание ссылок).",
    "type": "anime-db-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.5",
        "anime-db/plugin-contracts": "^0.26.2 || ^0.27"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "AnimeDb\\Plugins\\AnimedbWorldart\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AnimeDb\\Plugins\\AnimedbWorldart\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
