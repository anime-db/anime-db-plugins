{
    "name": "anime-db/anime-db-plugins",
    "description": "Market registry tooling for AnimeDB v2 plugins (manifest validation, PR change gate).",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.5",
        "ext-ftp": "*",
        "ext-sodium": "*",
        "anime-db/plugin-contracts": "~0.14",
        "composer/semver": "^3.4",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.5",
        "symfony/http-foundation": "8.1.*",
        "symfony/http-kernel": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "twig/twig": "^3.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/anime-db/anime-db-plugin-contracts.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "AnimeDb\\Plugins\\Tools\\": "tools/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AnimeDb\\Plugins\\Tools\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
